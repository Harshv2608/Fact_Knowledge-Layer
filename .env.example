# PostgreSQL Configuration
POSTGRES_USER=factuser
POSTGRES_PASSWORD=factpass
POSTGRES_DB=factdb
DATABASE_URL=postgresql://factuser:factpass@fact_db:5432/factdb

# Gemini API Keys (use up to 3 keys from different projects for parallel extraction)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_here
GEMINI_API_KEY_3=your_gemini_api_key_here
MOCK_LLM=0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
